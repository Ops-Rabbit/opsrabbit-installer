#!/usr/bin/env bash
set -euo pipefail
set +x

deploy_dir="${OPSRABBIT_DEPLOY_DIR:-/opt/opsrabbit}"
env_file="${deploy_dir}/.env"
compose_file="${deploy_dir}/docker-compose.yml"
helper_path="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"

if [[ "${1:-}" != deploy && "${1:-}" != update ]]; then
  for option in "$@"; do
    if [[ "${option}" == --ecr-password-stdin ]]; then
      echo "--ecr-password-stdin is supported only by deploy and update." >&2
      exit 2
    fi
  done
fi

if [[ ! -d "${deploy_dir}" ]]; then
  echo "OpsRabbit is not installed in ${deploy_dir}. Run the installer first." >&2
  exit 1
fi

# Run every command with the deployment owner's HOME, including AWS login/cache.
# sudo is an existing administrator permission, not a privilege granted here.
deploy_owner="$(stat -c '%U' "${deploy_dir}")"
if [[ "$(id -un)" != "${deploy_owner}" ]]; then
  if [[ "${EUID}" -ne 0 ]]; then
    echo "Using sudo to run OpsRabbit as ${deploy_owner}..."
    exec sudo -- env OPSRABBIT_DEPLOY_DIR="${deploy_dir}" "${helper_path}" "$@"
  fi
  owner_home="$(getent passwd "${deploy_owner}" | cut -d: -f6)"
  [[ -n "${owner_home}" ]] || { echo "Deployment owner has no home directory." >&2; exit 1; }
  cd /
  exec runuser -u "${deploy_owner}" -- env HOME="${owner_home}" \
    OPSRABBIT_DEPLOY_DIR="${deploy_dir}" "${helper_path}" "$@"
fi

if [[ ! -r "${env_file}" || ! -r "${compose_file}" ]]; then
  echo "Deployment configuration is missing or unreadable in ${deploy_dir}. Run the installer to repair it." >&2
  exit 1
fi

# Compose resolves relative paths and validates the working directory even when
# the Compose file itself is absolute. Never inherit an inaccessible directory
# such as /root when this helper is invoked through the root installer.
cd "${deploy_dir}"

release_dir="${deploy_dir}/.release"
case "${1:-}" in
  deploy|update|start|stop|restart|auth|login|https)
    command -v flock >/dev/null || { echo "Install util-linux before changing services or authentication." >&2; exit 1; }
    install -d -m 0700 "${release_dir}"
    exec {release_lock}>"${release_dir}/lock"
    flock -n "${release_lock}" || { echo "Another release or service operation is running." >&2; exit 1; }
    ;;
esac

read_env() {
  local key="$1" value
  value="$(sed -n "s/^${key}=//p" "${env_file}" | tail -n 1)"
  if [[ -z "${value}" ]]; then
    echo "Missing ${key} in ${env_file}." >&2
    exit 1
  fi
  printf '%s' "${value}"
}

aws_region="$(read_env AWS_REGION)"
ecr_registry="$(read_env ECR_REGISTRY)"
backend_port="$(read_env OPSRABBIT_BACKEND_PORT)"
web_port="$(read_env WEB_HTTP_PORT)"
sandbox_image="$(read_env OPSRABBIT_SANDBOX_IMAGE)"
opensandbox_port="$(read_env OPENSANDBOX_PORT)"
opensandbox_api_key="$(read_env OPENSANDBOX_SERVER_API_KEY)"

unset OPSRABBIT_DAEMON_IMAGE OPSRABBIT_WEB_IMAGE OPSRABBIT_SANDBOX_IMAGE
compose=(docker compose --env-file "${env_file}" -f "${compose_file}")
tls_override="${deploy_dir}/docker-compose.https.yml"
if [[ -f "${tls_override}" ]]; then compose+=(-f "${tls_override}"); fi
docker_config_dir=""
auth_candidate=""
auth_browser_candidate=""
auth_state_candidate=""

cleanup() {
  if [[ "${release_started:-false}" == true && -f "${release_dir}/pending.json" ]]; then
    echo "Release incomplete; web remains stopped until the pending release is recovered." >&2
    "${compose[@]}" stop web || echo "Could not stop web; isolate frontend serving before recovery." >&2
  fi
  if [[ -n "${release_candidate:-}" ]]; then rm -f -- "${release_candidate}" "${release_candidate}.compose.json" "${release_candidate}.compose.json.current"; fi
  if [[ -n "${docker_config_dir}" && -d "${docker_config_dir}" ]]; then
    rm -rf "${docker_config_dir}"
  fi
  if [[ -n "${auth_candidate}" ]]; then rm -f -- "${auth_candidate}"; fi
  if [[ -n "${auth_browser_candidate}" ]]; then rm -f -- "${auth_browser_candidate}"; fi
  if [[ -n "${auth_state_candidate}" ]]; then rm -f -- "${auth_state_candidate}"; fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

auth_library="$(dirname "${helper_path}")/scripts/aws-auth.sh"
if [[ ! -f "${auth_library}" ]]; then auth_library=/usr/local/lib/opsrabbit/aws-auth.sh; fi
# shellcheck source=scripts/aws-auth.sh
source "${auth_library}"
release_library="$(dirname "${helper_path}")/scripts/releases.sh"
if [[ ! -f "${release_library}" ]]; then release_library=/usr/local/lib/opsrabbit/releases.sh; fi
# shellcheck source=scripts/releases.sh
source "${release_library}"
if [[ -f "${release_dir}/current.json" && "${1:-}" != update && "${1:-}" != deploy ]]; then
  [[ -f "${release_dir}/current.compose.json" ]] || { echo "Installed release override is missing; resume the selected version with update." >&2; exit 1; }
  compose+=( -f "${release_dir}/current.compose.json" )
fi



ecr_login() {
  local login_output

  if [[ "${1:-}" == --ecr-password-stdin ]]; then
    local supplied_ecr_password=""
    if [[ -t 0 ]]; then
      echo "Pipe an ECR password into --ecr-password-stdin." >&2
      return 1
    fi
    if { IFS= read -r supplied_ecr_password || [[ -n "${supplied_ecr_password}" ]]; } && [[ -n "${supplied_ecr_password}" ]]; then
      export -n supplied_ecr_password
    else
      echo "A non-empty ECR password is required on stdin." >&2
      return 1
    fi
  fi

  if [[ -n "${docker_config_dir}" ]]; then rm -rf -- "${docker_config_dir}" || return 1; fi
  docker_config_dir="$(mktemp -d)" || return 1
  [[ -n "${docker_config_dir}" && -d "${docker_config_dir}" ]] || return 1
  chmod 0700 "${docker_config_dir}" || return 1
  export DOCKER_CONFIG="${docker_config_dir}"

  if [[ "${1:-}" == --ecr-password-stdin ]]; then
    if ! printf '%s\n' "${supplied_ecr_password}" | docker login --username AWS --password-stdin "${ecr_registry}" >/dev/null 2>&1; then
      echo "ECR login failed for the supplied password." >&2
      return 1
    fi
  elif ! login_output="$(
    aws ecr get-login-password --region "${aws_region}" \
      | docker login --username AWS --password-stdin "${ecr_registry}" 2>&1
  )"; then
    echo "${login_output}" >&2
    echo "ECR login failed. Renew or change authentication with: opsrabbitctl auth login" >&2
    return 1
  fi

  echo "ECR login succeeded using a temporary Docker credential file."
}

auth_validate() {
  local image image_key
  auth_identity || return 1
  ecr_login || return 1
  echo "Checking access to required image manifests..."
  for image_key in OPSRABBIT_DAEMON_IMAGE OPSRABBIT_WEB_IMAGE OPSRABBIT_SANDBOX_IMAGE; do
    image="$(read_env "${image_key}")" || return 1
    if [[ "${image}" == opsrabbit-release:unconfigured ]]; then
      echo "Product images will be checked after release selection."
      continue
    fi
    if ! docker manifest inspect "${image}" >/dev/null; then
      echo "Cannot read image ${image}. Check image existence and ECR pull permissions for the identity above." >&2
      return 1
    fi
    echo "  ${image}: OK"
  done
  image="$(opensandbox_image)" || return 1
  if ! docker manifest inspect "${image}" >/dev/null; then
    echo "Cannot read image ${image}. Check image existence and ECR pull permissions for the identity above." >&2
    return 1
  fi
  echo "  ${image}: OK"
}

authenticate() {
  auth_load || return 1
  auth_prepare || return 1
  if ! auth_validate; then
    echo "Deployment stopped before changing services. Run: opsrabbitctl auth login" >&2
    return 1
  fi
}

opensandbox_image() {
  "${compose[@]}" config --format json \
    | jq -er '.services["opensandbox-server"].image | select(type == "string" and length > 0)'
}

verify_service_image() {
  local service="$1" image="$2" container actual expected
  container="$("${compose[@]}" ps -q "${service}")" || return 1
  [[ -n "${container}" ]] || { echo "${service} container is missing." >&2; return 1; }
  expected="$(docker image inspect --format '{{.Id}}' "${image}")" || return 1
  actual="$(docker inspect --format '{{.Image}}' "${container}")" || return 1
  [[ -n "${expected}" && "${actual}" == "${expected}" ]] || {
    echo "${service} is not running the configured image ${image}." >&2
    return 1
  }
}

connect_opensandbox_runtime_bridge() {
  local container_id bridge_status

  container_id="$("${compose[@]}" ps -q opensandbox-server)"
  if [[ -z "${container_id}" ]]; then
    echo "OpenSandbox lifecycle container was not created." >&2
    return 1
  fi

  bridge_status="$(docker inspect --format '{{with index .NetworkSettings.Networks "bridge"}}connected{{end}}' "${container_id}")"
  if [[ "${bridge_status}" != "connected" ]]; then
    docker network connect bridge "${container_id}"
  fi
}

start_opensandbox() {
  local image
  image="$(opensandbox_image)" || return 1
  "${compose[@]}" up -d --no-build "$@" --wait opensandbox-server || return 1
  connect_opensandbox_runtime_bridge || return 1
  verify_service_image opensandbox-server "${image}"
}

start_services() {
  local remove_orphans=()
  if [[ "${1:-}" == "remove-orphans" ]]; then
    remove_orphans=(--remove-orphans)
  fi

  # OpenSandbox creates sandboxes on Docker's built-in bridge because its
  # deny-all network policy is implemented there. Join only the lifecycle
  # service to that bridge before the backend can send sandbox traffic.
  start_opensandbox "${remove_orphans[@]}" || return 1
  "${compose[@]}" up -d --no-build "${remove_orphans[@]}" --wait
}

fail() { echo "$*" >&2; return 1; }

optional_env() {
  sed -n "s/^${1}=//p" "${env_file}" | tail -n 1
}

validate_certificate() {
  local cert="$1" key="$2" hostname="$3" cert_public key_public
  [[ -r "$cert" && -r "$key" ]] || { fail "Certificate and key must be readable files."; return 1; }
  openssl x509 -in "$cert" -noout -checkend 0 >/dev/null || return 1
  openssl x509 -in "$cert" -noout -checkhost "$hostname" | grep -q 'does match certificate' || {
    fail "Certificate does not match hostname."; return 1;
  }
  # Empty passphrase fails promptly for encrypted keys rather than prompting.
  cert_public="$(openssl x509 -in "$cert" -pubkey -noout)" || return 1
  key_public="$(openssl pkey -in "$key" -passin pass: -pubout)" || return 1
  [[ "$cert_public" == "$key_public" ]] || { fail "Certificate and private key do not match."; return 1; }
}

set_env() {
  local key="$1" value="$2" target="$3" next="${3}.next"
  awk -v key="$key" -v value="$value" '
    index($0, key "=") != 1 { print }
    END { print key "=" value }
  ' "$target" > "$next"
  chmod 0600 "$next"
  mv "$next" "$target"
}

https_configure() (
  set -euo pipefail
  umask 077
  [[ ! -f "${release_dir}/pending.json" ]] || { fail "Resume the pending release before changing HTTPS."; exit 1; }
  [[ "$deploy_dir" =~ ^/[a-zA-Z0-9_./-]+$ ]] || { fail "HTTPS setup requires a deployment path without spaces or special characters."; exit 2; }
  mkdir "${deploy_dir}/.https-lock" 2>/dev/null || { fail "Another HTTPS configuration is running; check ${deploy_dir}/.https-lock."; exit 1; }
  trap 'rmdir "${deploy_dir}/.https-lock"' EXIT
  local hostname="" cert="" key="" mode=keep port=443 option
  while [[ $# -gt 0 ]]; do
    option="$1"; shift
    [[ $# -gt 0 ]] || { fail "Missing value for ${option}."; exit 2; }
    case "$option" in
      --hostname) hostname="$1" ;;
      --cert) cert="$1" ;;
      --key) key="$1" ;;
      --http-mode) mode="$1" ;;
      --https-port) port="$1" ;;
      *) fail "Unknown HTTPS option: ${option}"; exit 2 ;;
    esac
    shift
  done
  [[ "$hostname" =~ ^[a-zA-Z0-9]([a-zA-Z0-9.-]*[a-zA-Z0-9])?$ && "$hostname" == *.* && "$hostname" != *..* ]] || {
    fail "Supply a DNS hostname without a scheme, port or path."; exit 2;
  }
  case "$mode" in
    keep|redirect|disable) ;;
    *) fail "HTTP mode must be keep, redirect or disable."; exit 2 ;;
  esac
  if [[ ! "$port" =~ ^[1-9][0-9]{0,4}$ ]] || (( port > 65535 )); then
    fail "Invalid HTTPS port."; exit 2
  fi
  [[ "$port" != "$web_port" ]] || { fail "HTTP and HTTPS ports must differ."; exit 2; }
  # Nginx's existing redirect template uses standard HTTPS port 443.
  [[ "$mode" != redirect || "$port" == 443 ]] || { fail "Redirect mode requires HTTPS port 443."; exit 2; }
  validate_certificate "$cert" "$key" "$hostname"
  local version major minor patch
  local version_pattern='^v?([0-9]+)\.([0-9]+)\.([0-9]+)([-+][0-9A-Za-z.~+-]+)?$'
  version="$(docker compose version --short)"
  if [[ "$version" =~ $version_pattern ]]; then
    major=$(( "10#${BASH_REMATCH[1]}" ))
    minor=$(( "10#${BASH_REMATCH[2]}" ))
    patch=$(( "10#${BASH_REMATCH[3]}" ))
  else
    fail "Cannot determine Compose version."; exit 1
  fi
  (( major > 2 || (major == 2 && (minor > 24 || (minor == 24 && patch >= 4))) )) || {
    fail "HTTPS requires Docker Compose 2.24.4 or newer."; exit 1;
  }
  local backup="" tls_dir="" previous_dir activated=false committed=false had_override=false
  previous_dir="$(optional_env OPSRABBIT_HTTPS_CERT_DIR)"
  rollback() {
    local result=$? recovery_failed=false
    trap - EXIT INT TERM
    # Recovery must attempt every step even when one operation fails.
    set +e
    if [[ "$activated" == true && "$committed" == false && $result -ne 0 ]]; then
      if ! cp "$backup/env" "$env_file"; then recovery_failed=true; fi
      if [[ "$had_override" == true ]]; then
        if ! cp "$backup/override" "$tls_override"; then recovery_failed=true; fi
      elif ! rm -f "$tls_override"; then
        recovery_failed=true
      fi
      local restore=(docker compose --env-file "$env_file" -f "$compose_file")
      if [[ -f "${release_dir}/current.compose.json" ]]; then restore+=(-f "${release_dir}/current.compose.json"); fi
      if [[ "$had_override" == true ]]; then restore+=(-f "$tls_override"); fi
      if [[ "$recovery_failed" == false ]]; then
        if ! "${restore[@]}" up -d --no-build --wait --wait-timeout 120 daemon web; then recovery_failed=true; fi
      fi
    fi
    if [[ "$recovery_failed" == true ]]; then
      echo "HTTPS activation and recovery did not complete. Recovery files retained at ${backup}; candidate certificates retained at ${tls_dir}. Inspect services before retrying opsrabbitctl start." >&2
    else
      if [[ -n "$backup" ]] && ! rm -rf "$backup"; then echo "Could not remove HTTPS backup directory: ${backup}" >&2; fi
      if [[ "$committed" == false && -n "$tls_dir" ]] && ! rm -rf "$tls_dir"; then echo "Could not remove unused certificates: ${tls_dir}" >&2; fi
    fi
    if ! rmdir "${deploy_dir}/.https-lock"; then echo "Could not remove HTTPS lock directory; inspect it before retrying." >&2; fi
    exit "$result"
  }
  trap rollback EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  backup="$(mktemp -d "${deploy_dir}/.https-backup.XXXXXX")"
  tls_dir="$(mktemp -d "${deploy_dir}/.https-certs.XXXXXX")"
  cp "$env_file" "$backup/env"
  if [[ -f "$tls_override" ]]; then cp "$tls_override" "$backup/override"; had_override=true; fi
  cp "$cert" "$tls_dir/fullchain.pem"
  cp "$key" "$tls_dir/privkey.pem"
  # Parent is 0700; mounted files must also be readable by image's non-root Nginx.
  chmod 0444 "$tls_dir/fullchain.pem" "$tls_dir/privkey.pem"
  validate_certificate "$tls_dir/fullchain.pem" "$tls_dir/privkey.pem" "$hostname"
  local tls_mode=both redirect=false origin="https://${hostname}" bind
  [[ "$mode" != disable ]] || tls_mode=https
  [[ "$mode" != redirect ]] || redirect=true
  [[ "$port" == 443 ]] || origin="${origin}:${port}"
  bind="$(optional_env WEB_BIND_ADDRESS)"; bind="${bind:-0.0.0.0}"
  [[ "$bind" =~ ^[0-9.]+$ ]] || { fail "HTTPS configuration currently requires an IPv4 WEB_BIND_ADDRESS."; exit 2; }
  cp "$env_file" "$backup/new-env"
  set_env OPSRABBIT_WEB_ORIGIN "$origin" "$backup/new-env"
  set_env OPSRABBIT_NODE_BASE_URL "$origin/api" "$backup/new-env"
  set_env OPSRABBIT_HTTPS_HOSTNAME "$hostname" "$backup/new-env"
  set_env OPSRABBIT_HTTPS_HTTP_MODE "$mode" "$backup/new-env"
  set_env OPSRABBIT_HTTPS_PORT "$port" "$backup/new-env"
  set_env OPSRABBIT_HTTPS_CERT_DIR "$tls_dir" "$backup/new-env"
  # Single-quote YAML paths; Compose interpolation must not interpret host paths.
  local yaml_dir="${tls_dir//\'/\'\'}"
  yaml_dir="${yaml_dir//\$/\$\$}"
  cat > "$backup/new-override" <<EOF
services:
  web:
    ports: !override
EOF
  if [[ "$mode" != disable ]]; then printf '      - "%s:%s:80"\n' "$bind" "$web_port" >> "$backup/new-override"; fi
  cat >> "$backup/new-override" <<EOF
      - "${bind}:${port}:443"
    environment:
      WEB_TLS_MODE: ${tls_mode}
      WEB_TLS_REDIRECT: "${redirect}"
      WEB_SERVER_NAME: "${hostname}"
      WEB_TLS_CERT_FILE: /etc/nginx/certs/fullchain.pem
      WEB_TLS_KEY_FILE: /etc/nginx/certs/privkey.pem
    volumes:
      - '${yaml_dir}/fullchain.pem:/etc/nginx/certs/fullchain.pem:ro'
      - '${yaml_dir}/privkey.pem:/etc/nginx/certs/privkey.pem:ro'
    healthcheck:
      test: ["CMD-SHELL", "wget --no-check-certificate --spider --quiet https://127.0.0.1/"]
EOF
  local candidate=(docker compose --env-file "$backup/new-env" -f "$compose_file")
  if [[ -f "${release_dir}/current.compose.json" ]]; then candidate+=(-f "${release_dir}/current.compose.json"); fi
  candidate+=(-f "$backup/new-override")
  "${candidate[@]}" config --quiet
  activated=true
  cp "$backup/new-env" "$env_file"
  cp "$backup/new-override" "$tls_override"
  local active=(docker compose --env-file "$env_file" -f "$compose_file")
  if [[ -f "${release_dir}/current.compose.json" ]]; then active+=(-f "${release_dir}/current.compose.json"); fi
  active+=(-f "$tls_override")
  "${active[@]}" up -d --no-build --wait --wait-timeout 120 daemon web
  committed=true
  if [[ "$previous_dir" == "${deploy_dir}/.https-certs."* && "$previous_dir" != "$tls_dir" && ! -L "$previous_dir" ]]; then
    local previous_suffix="${previous_dir#"${deploy_dir}/.https-certs."}"
    if [[ "$previous_suffix" =~ ^[a-zA-Z0-9]+$ ]]; then
      if ! rm -rf "$previous_dir"; then
        echo "HTTPS is active, but old certificate cleanup failed at ${previous_dir}. Remove that unused directory after checking it." >&2
      fi
    fi
  fi
  echo "HTTPS configured at ${origin}; HTTP mode: ${mode}."
  echo "Certificate files retained in ${tls_dir}; rotate with https reload --cert FILE --key FILE."
)

https_reload() {
  local hostname mode port
  hostname="$(read_env OPSRABBIT_HTTPS_HOSTNAME)"
  mode="$(read_env OPSRABBIT_HTTPS_HTTP_MODE)"
  port="$(read_env OPSRABBIT_HTTPS_PORT)"
  [[ $# -gt 0 ]] || { fail "Usage: opsrabbitctl https reload --cert FULLCHAIN --key PRIVATE_KEY"; return 2; }
  local arg
  for arg in "$@"; do
    case "$arg" in
      --hostname|--http-mode|--https-port) fail "Reload only accepts --cert and --key; use configure to change settings."; return 2 ;;
    esac
  done
  https_configure --hostname "$hostname" --http-mode "$mode" --https-port "$port" "$@"
}

case "${1:-}" in
  https)
    case "${2:-}" in
      configure) https_configure "${@:3}" ;;
      reload) https_reload "${@:3}" ;;
      *) fail "Usage: opsrabbitctl https {configure --hostname HOST --cert FILE --key FILE [--http-mode keep|redirect|disable] [--https-port PORT]|reload --cert FILE --key FILE}"; exit 2 ;;
    esac
    ;;
  auth)
    case "${2:-}" in
      configure) auth_configure ;;
      login) auth_renew ;;
      status) auth_load; auth_prepare; auth_identity ;;
      *) echo "Usage: opsrabbitctl auth {configure|login|status}" >&2; exit 2 ;;
    esac
    ;;
  login)
    authenticate
    ;;
  deploy|update)
    shift
    release_deploy "$@"
    ;;
  start)
    [[ ! -f "${release_dir}/pending.json" ]] || { echo "Resume the pending release before starting services." >&2; exit 1; }
    start_services
    ;;
  stop)
    "${compose[@]}" stop daemon
    "${compose[@]}" stop
    ;;
  restart)
    [[ ! -f "${release_dir}/pending.json" ]] || { echo "Resume the pending release before restarting." >&2; exit 1; }
    "${compose[@]}" stop daemon
    "${compose[@]}" restart
    ;;
  status)
    for state in current pending; do
      if [[ -f "${release_dir}/${state}.json" ]]; then echo "${state}: $(jq -r .version "${release_dir}/${state}.json")"; fi
    done
    "${compose[@]}" ps
    ;;
  logs)
    "${compose[@]}" logs --tail=200 -f "${@:2}"
    ;;
  health)
    curl --fail --show-error --silent "http://127.0.0.1:${backend_port}/health"
    echo
    if [[ -f "$tls_override" ]]; then
      hostname="$(read_env OPSRABBIT_HTTPS_HOSTNAME)"
      port="$(read_env OPSRABBIT_HTTPS_PORT)"
      bind="$(optional_env WEB_BIND_ADDRESS)"; bind="${bind:-0.0.0.0}"
      [[ "$bind" != 0.0.0.0 ]] || bind=127.0.0.1
      curl --noproxy '*' --fail --show-error --silent --output /dev/null \
        --resolve "${hostname}:${port}:${bind}" "https://${hostname}:${port}/"
    else
      curl --fail --show-error --silent --output /dev/null "http://127.0.0.1:${web_port}/"
    fi
    echo "Web health check passed."
    curl --fail --show-error --silent --output /dev/null "http://127.0.0.1:${opensandbox_port}/health"
    unauthenticated_status="$(
      curl --silent --output /dev/null --write-out '%{http_code}' \
        "http://127.0.0.1:${opensandbox_port}/v1/sandboxes"
    )"
    if [[ "${unauthenticated_status}" != "401" ]]; then
      echo "OpenSandbox lifecycle API accepted an unauthenticated request (HTTP ${unauthenticated_status})." >&2
      exit 1
    fi
    printf 'OPEN-SANDBOX-API-KEY: %s\n' "${opensandbox_api_key}" \
      | curl --fail --show-error --silent --output /dev/null --header @- \
        "http://127.0.0.1:${opensandbox_port}/v1/sandboxes"
    docker image inspect "${sandbox_image}" >/dev/null
    verify_service_image opensandbox-server "$(opensandbox_image)"
    echo "OpenSandbox health, authentication, and sandbox image checks passed."
    ;;
  *)
    echo "Usage: opsrabbitctl {update|deploy [--adopt]} [--version vX.Y.Z] [--ecr-password-stdin] {--backup-confirmed|--skip-backup} | {auth {configure|login|status}|login|start|stop|restart|status|logs [service]|health|https configure|https reload}" >&2
    exit 2
    ;;
esac
