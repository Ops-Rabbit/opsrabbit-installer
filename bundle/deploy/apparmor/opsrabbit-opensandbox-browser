# Browser-only Bubblewrap entrypoint. Ordinary /usr/bin/bwrap policy is untouched.
# The entrypoint exists only in the image, never on the host. Standard containers
# must retain Docker confinement; workspace commands retain their generic deny
# stack. Do not use this profile for deliberately unconfined standard workloads.
# Full Px targets keep the initial profile (Bubblewrap's no-new-privileges
# baseline) while selecting the controller or immutable Chromium component.
abi <abi/4.0>,
include <tunables/global>

@{opsrabbit_chromium} = /opt/opsrabbit-agent-browser/chromium/chrome
@{opsrabbit_browser_controller_exec} = /{bin,sbin,usr,lib,lib64,lib32,libx32}/** /opt/opsrabbit-global-tools/** /opt/opsrabbit-agent-browser/chromium/chrome_crashpad_handler

profile opsrabbit-opensandbox-browser /opt/opsrabbit-system/bin/browser-bwrap flags=(attach_disconnected) {
  allow capability,
  allow file rwlkm /{**,},
  allow network,
  allow unix,
  allow ptrace,
  allow signal,
  allow mqueue,
  allow io_uring,
  allow userns,
  allow mount,
  allow umount,
  allow pivot_root,
  allow dbus,

  allow Px @{opsrabbit_browser_controller_exec} -> opsrabbit-opensandbox-browser//&opsrabbit-opensandbox-browser-controller,
  allow Px @{opsrabbit_chromium} -> opsrabbit-opensandbox-browser//&opsrabbit-opensandbox-chromium,
}

profile opsrabbit-opensandbox-browser-controller flags=(attach_disconnected) {
  allow file rwlkm /{**,},
  allow network,
  allow unix,
  allow ptrace,
  allow signal,
  allow mqueue,
  allow io_uring,
  allow userns,
  allow mount,
  allow umount,
  allow pivot_root,
  allow dbus,

  allow Px @{opsrabbit_browser_controller_exec} -> opsrabbit-opensandbox-browser//&opsrabbit-opensandbox-browser-controller,
  allow Px @{opsrabbit_chromium} -> opsrabbit-opensandbox-browser//&opsrabbit-opensandbox-chromium,
  audit deny capability,
}

profile opsrabbit-opensandbox-chromium flags=(attach_disconnected) {
  allow capability sys_admin,
  allow capability sys_chroot,
  allow file rwlkm /{**,},
  allow network,
  allow unix,
  allow ptrace,
  allow signal,
  allow mqueue,
  allow io_uring,
  allow userns,
  allow mount,
  allow umount,
  allow pivot_root,
  allow dbus,

  allow Px @{opsrabbit_browser_controller_exec} -> opsrabbit-opensandbox-browser//&opsrabbit-opensandbox-browser-controller,
  allow Px @{opsrabbit_chromium} -> opsrabbit-opensandbox-browser//&opsrabbit-opensandbox-chromium,
}
