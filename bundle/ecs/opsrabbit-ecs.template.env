# Copy this file and replace all placeholder values.
# Use these as environment variables for CloudFormation deployments.

StackName=opsrabbit-ecs
VpcId=vpc-xxxxxxxxxxxxxxxxx
PublicSubnets=subnet-xxxxxxxxxxxxxxxxx,subnet-yyyyyyyyyyyyyyyyy
PrivateSubnets=subnet-xxxxxxxxxxxxxxxxx,subnet-yyyyyyyyyyyyyyyyy
ExecutionRoleArn=arn:aws:iam::123456789012:role/ecsTaskExecutionRole
TaskRoleArn=arn:aws:iam::123456789012:role/opsrabbitEcsTaskRole

ALBName=opsrabbit-alb
ClusterName=opsrabbit-cluster
DesiredCount=1
Cpu=512
Memory=2048

OPSRABBIT_DAEMON_IMAGE=921870554228.dkr.ecr.us-east-1.amazonaws.com/vg-backend:latestv2
OPSRABBIT_WEB_IMAGE=921870554228.dkr.ecr.us-east-1.amazonaws.com/vg-webapp:latestv2
OPSRABBIT_NODE_DATABASE_URL=postgresql://postgres:password@db.example.com:5432/opsrabbit_neo
BETTER_AUTH_SECRET=change-me
OPSRABBIT_NODE_ENCRYPTION_KEY=change-me
OPSRABBIT_WEB_ORIGIN=https://opsrabbit.example.com

OPSRABBIT_NODE_BASE_URL=https://opsrabbit.example.com/api
OPSRABBIT_BACKEND_PORT=8384
WEB_HTTP_PORT=80
