# Non-secret CloudFormation parameter example. Replace every placeholder.
# Store application secrets in AWS Secrets Manager, not in this file.
StackName=opsrabbit
VpcId=vpc-REPLACE_ME
PublicSubnets=subnet-PUBLIC_A,subnet-PUBLIC_B
PrivateSubnets=subnet-PRIVATE_A,subnet-PRIVATE_B
DatabaseSecurityGroupId=sg-RDS_REPLACE_ME
AllowedIngressCidr=203.0.113.0/24
AllowedHttpsEgressCidr=0.0.0.0/0
OpsRabbitDaemonImage=REPLACE_WITH_MARKETPLACE_DAEMON_IMAGE_URI_OR_DIGEST
OpsRabbitWebImage=REPLACE_WITH_MARKETPLACE_WEB_IMAGE_URI_OR_DIGEST
ApplicationSecretArn=arn:aws:secretsmanager:us-east-1:123456789012:secret:opsrabbit/application-REPLACE_ME
PublicDomainName=opsrabbit.example.com
CertificateArn=arn:aws:acm:us-east-1:123456789012:certificate/REPLACE_ME
DesiredCount=1
LogRetentionDays=30
